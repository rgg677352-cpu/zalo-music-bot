# Không bắt buộc đổi gì để thử bot.
PREFIX=!
# Để trống: hoạt động trong mọi nhóm có tài khoản bot.
# Muốn giới hạn nhóm, gõ !id trong nhóm rồi điền ID, cách nhau bằng dấu phẩy.
ALLOWED_GROUP_IDS=
# Để trống: mọi thành viên trong nhóm được gọi lệnh.
# Có thể giới hạn người dùng bằng UID, cách nhau bằng dấu phẩy.
ALLOWED_USER_IDS=
MAX_DURATION_SECONDS=600
